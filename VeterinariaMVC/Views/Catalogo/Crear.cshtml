@model VeterinariaMVC.Models.ItemCatalogo
@using VeterinariaMVC.Models
@{
    ViewData["Title"] = "Nuevo registro del catálogo";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Nuevo registro del catálogo</h1>
    <p class="text-secondary mb-0">Agregue un medicamento o tratamiento al catálogo clínico.</p>
</div>

<div class="card p-4" style="max-width: 40rem;">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" maxlength="100" autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select">
                <option value="0">Seleccione el tipo...</option>
                <option value="@((int)TipoItemCatalogo.Medicamento)">Medicamento</option>
                <option value="@((int)TipoItemCatalogo.Tratamiento)">Tratamiento</option>
            </select>
            <span asp-validation-for="Tipo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="500"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}