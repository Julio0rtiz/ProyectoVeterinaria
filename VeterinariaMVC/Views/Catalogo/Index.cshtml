@model IEnumerable<VeterinariaMVC.Models.ItemCatalogo>
@using VeterinariaMVC.Models
@{
    ViewData["Title"] = "Catálogo clínico";
    var tipo = ViewBag.Tipo as TipoItemCatalogo?;
    var q = ViewBag.Q as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Catálogo clínico</h1>
        <p class="text-secondary mb-0">Medicamentos y tratamientos disponibles para asignar en expedientes.</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Crear">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar ítem
        </a>
    </div>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4 col-lg-3">
            <label for="tipo" class="visually-hidden">Filtrar por tipo</label>
            <select id="tipo" name="tipo" class="form-select">
                <option value="">Todos los tipos</option>
                <option value="@((int)TipoItemCatalogo.Medicamento)" selected="@(tipo == TipoItemCatalogo.Medicamento)">
                    Medicamento</option>
                    <option value="@((int)TipoItemCatalogo.Tratamiento)" selected="@(tipo == TipoItemCatalogo.Tratamiento)">
                        Tratamiento</option>
                    </select>
                </div>
                <div class="col-12 col-md-5 col-lg-6">
                    <label for="q" class="visually-hidden">Buscar en el catálogo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input type="text" id="q" name="q" value="@q" class="form-control"
                               placeholder="Buscar por nombre o descripción..." />
                    </div>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    @if (tipo.HasValue || !string.IsNullOrWhiteSpace(q))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    }
                </div>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="card p-4 text-center">
                @if (tipo.HasValue || !string.IsNullOrWhiteSpace(q))
                {
                    <p class="mb-2">No se encontraron ítems que coincidan con los filtros seleccionados.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todo el catálogo</a>
                    </div>
                }
                else
                {
                    <p class="mb-3">No hay medicamentos ni tratamientos registrados. Agregue el primero.</p>
                    <div>
                        <a asp-action="Crear" class="btn btn-primary">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar ítem
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Nombre</td>
                                    <td>
                                        @if (item.Tipo == TipoItemCatalogo.Medicamento)
                                        {
                                            <span class="badge text-bg-primary">
                                                <i class="bi bi-capsule" aria-hidden="true"></i> Medicamento
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning text-dark">
                                                <i class="bi bi-bandaid" aria-hidden="true"></i> Tratamiento
                                            </span>
                                        }
                                    </td>
                                    <td class="text-secondary">@item.Descripcion</td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"
                                           title="Editar" aria-label="Editar @item.Nombre">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Eliminar este ítem del catálogo?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                    aria-label="Eliminar @item.Nombre">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }