@model VeterinariaMVC.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="formulario-acceso">
    <h1 class="h3 mb-1">Iniciar sesión</h1>
    <p class="text-body-secondary mb-4">Ingrese con el correo y la contraseña de su cuenta de la clínica.</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label"></label>
            <input asp-for="Correo" class="form-control form-control-lg" autocomplete="username" autofocus />
            <span asp-validation-for="Correo" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Contrasena" class="form-label"></label>
            <input asp-for="Contrasena" class="form-control form-control-lg" autocomplete="current-password" />
            <span asp-validation-for="Contrasena" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
