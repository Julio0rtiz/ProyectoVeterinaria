@model VeterinariaMVC.Models.Especie
@{
    ViewData["Title"] = "Nueva especie";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Nueva especie</h1>
    <p class="text-secondary mb-0">Registre una nueva especie animal en el catálogo.</p>
</div>

<div class="card p-4" style="max-width: 34rem;">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" maxlength="50" autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}