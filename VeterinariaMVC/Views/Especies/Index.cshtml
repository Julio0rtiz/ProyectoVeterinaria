@model IEnumerable<VeterinariaMVC.Models.Especie>
@{
    ViewData["Title"] = "Especies";
    var q = ViewBag.Q as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Especies</h1>
        <p class="text-secondary mb-0">Especies atendidas en la clínica y sus razas asociadas.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Razas" asp-action="Index">
            <i class="bi bi-list-ul" aria-hidden="true"></i> Todas las razas
        </a>
        <a class="btn btn-primary" asp-action="Crear">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar especie
        </a>
    </div>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-8 col-lg-6">
            <label for="q" class="visually-hidden">Buscar especie</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="text" id="q" name="q" value="@q" class="form-control"
                       placeholder="Buscar por nombre de especie..." />
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <p class="mb-2">No se encontraron especies que coincidan con «@q».</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todas las especies</a>
            </div>
        }
        else
        {
            <p class="mb-3">No hay especies registradas. Agregue la primera.</p>
            <div>
                <a asp-action="Crear" class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar especie
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Razas registradas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>
                                <span class="badge text-bg-light border">@item.Razas.Count</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Razas" asp-action="Index"
                                   asp-route-especieId="@item.Id">
                                    <i class="bi bi-tags" aria-hidden="true"></i> Ver razas
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"
                                   title="Editar" aria-label="Editar @item.Nombre">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar esta especie?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                            aria-label="Eliminar @item.Nombre">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}