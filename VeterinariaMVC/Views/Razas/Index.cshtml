@model IEnumerable<VeterinariaMVC.Models.Raza>
@{
    ViewData["Title"] = "Razas";
    var especieId = ViewBag.EspecieId as int?;
    var q = ViewBag.Q as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Razas</h1>
        <p class="text-secondary mb-0">Razas registradas por especie en la clínica.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Especies" asp-action="Index">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Ver especies
        </a>
        <a class="btn btn-primary" asp-action="Crear" asp-route-especieId="@especieId">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nueva raza
        </a>
    </div>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <label for="especieId" class="visually-hidden">Filtrar por especie</label>
            <select id="especieId" name="especieId" asp-items="ViewBag.Especies" class="form-select">
                <option value="">Todas las especies</option>
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label for="q" class="visually-hidden">Buscar raza</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="text" id="q" name="q" value="@q" class="form-control"
                       placeholder="Buscar por nombre de raza..." />
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            @if ((especieId.HasValue && especieId.Value > 0) || !string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        @if ((especieId.HasValue && especieId.Value > 0) || !string.IsNullOrWhiteSpace(q))
        {
            <p class="mb-2">No se encontraron razas con los filtros seleccionados.</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todas las razas</a>
            </div>
        }
        else
        {
            <p class="mb-3">No hay razas registradas. Agregue la primera.</p>
            <div>
                <a asp-action="Crear" class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar raza
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Raza</th>
                        <th>Especie</th>
                        <th>Mascotas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.Especie?.Nombre</td>
                            <td>
                                <span class="badge text-bg-light border">@item.Mascotas.Count</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-success" asp-action="Editar" asp-route-id="@item.Id"
                                   title="Editar" aria-label="Editar @item.Nombre">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar esta raza?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                            aria-label="Eliminar @item.Nombre">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}