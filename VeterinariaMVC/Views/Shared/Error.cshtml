@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="pagina-aviso">
    <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
    <h1 class="h3 mt-3 mb-2">No se pudo completar la solicitud</h1>
    <p class="text-body-secondary mb-4">Ocurrió un error inesperado. Vuelva al inicio e intente de nuevo; si se repite, comunique el código de abajo a la persona encargada del sistema.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary">Código de la solicitud: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
