<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica Veterinaria</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdministrador = User.IsInRole("Administrador");
    var esVeterinario = User.IsInRole("Veterinario");
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    bool EsActivo(params string[] controladores) => controladores.Contains(controladorActual);
}
<body class="@(autenticado ? "con-sesion" : "sin-sesion")">
    @if (autenticado)
    {
        <div class="carpeta">
            <aside class="riel">
                <div class="riel-cabecera">
                    <a class="marca" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                        <span>Clínica Veterinaria</span>
                    </a>
                    <button class="riel-alternar d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                            aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="collapse d-lg-flex riel-cuerpo" id="menuPrincipal">
                    <nav class="riel-menu" aria-label="Menú principal">
                        <ul class="pestanas">
                            <li>
                                <a class="pestana @(EsActivo("Home") ? "activa" : "")"
                                   aria-current="@(EsActivo("Home") ? "page" : null)"
                                   asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house" aria-hidden="true"></i> Inicio
                                </a>
                            </li>
                        </ul>
                        @if (esAdministrador || esVeterinario)
                        {
                            <p class="riel-grupo">Atención clínica</p>
                            <ul class="pestanas">
                                <li>
                                    <a class="pestana @(EsActivo("Veterinaria", "Expediente") ? "activa" : "")"
                                       aria-current="@(EsActivo("Veterinaria", "Expediente") ? "page" : null)"
                                       asp-controller="Veterinaria" asp-action="Index">
                                        <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Veterinaria
                                    </a>
                                </li>
                                <li>
                                    <a class="pestana @(EsActivo("Mascotas") ? "activa" : "")"
                                       aria-current="@(EsActivo("Mascotas") ? "page" : null)"
                                       asp-controller="Mascotas" asp-action="Index">
                                        <i class="bi bi-heart" aria-hidden="true"></i> Mascotas
                                    </a>
                                </li>
                            </ul>
                        }
                        @if (esAdministrador)
                        {
                            <p class="riel-grupo">Administración</p>
                            <ul class="pestanas">
                                <li>
                                    <a class="pestana @(EsActivo("Especies", "Razas") ? "activa" : "")"
                                       aria-current="@(EsActivo("Especies", "Razas") ? "page" : null)"
                                       asp-controller="Especies" asp-action="Index">
                                        <i class="bi bi-tags" aria-hidden="true"></i> Especies y razas
                                    </a>
                                </li>
                                <li>
                                    <a class="pestana @(EsActivo("Catalogo") ? "activa" : "")"
                                       aria-current="@(EsActivo("Catalogo") ? "page" : null)"
                                       asp-controller="Catalogo" asp-action="Index">
                                        <i class="bi bi-capsule" aria-hidden="true"></i> Catálogo clínico
                                    </a>
                                </li>
                                <li>
                                    <a class="pestana @(EsActivo("Veterinarios") ? "activa" : "")"
                                       aria-current="@(EsActivo("Veterinarios") ? "page" : null)"
                                       asp-controller="Veterinarios" asp-action="Index">
                                        <i class="bi bi-person-badge" aria-hidden="true"></i> Veterinarios
                                    </a>
                                </li>
                                <li>
                                    <a class="pestana @(EsActivo("Usuarios") ? "activa" : "")"
                                       aria-current="@(EsActivo("Usuarios") ? "page" : null)"
                                       asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-people" aria-hidden="true"></i> Usuarios
                                    </a>
                                </li>
                            </ul>
                        }
                    </nav>

                    <div class="riel-usuario">
                        <div class="riel-persona">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <div>
                                <strong>@User.Identity!.Name</strong>
                                <span>@(esAdministrador ? "Administrador" : "Veterinario")</span>
                            </div>
                        </div>
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn-salir">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="hoja">
                <main role="main" class="hoja-contenido">
                    <partial name="_Mensajes" />
                    @RenderBody()
                </main>
                <footer class="hoja-pie">
                    <span>&copy; @DateTime.Now.Year Clínica Veterinaria, expediente electrónico</span>
                    <span>Desarrollo de Software IV, UCR Sede de Occidente</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="acceso">
            <div class="acceso-marca">
                <span class="marca">
                    <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                    <span>Clínica Veterinaria</span>
                </span>
                <p>El expediente de cada paciente, con sus vacunas, tratamientos, exámenes y notas, en un solo lugar.</p>
            </div>
            <main role="main" class="acceso-hoja">
                <div class="acceso-contenido">
                    <partial name="_Mensajes" />
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
