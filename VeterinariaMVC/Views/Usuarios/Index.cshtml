@model IEnumerable<VeterinariaMVC.Models.Usuario>
@using VeterinariaMVC.Models
@{
    ViewData["Title"] = "Usuarios";
    var perfil = ViewBag.Perfil as Perfil?;
    var bloqueado = ViewBag.Bloqueado as bool?;
    var q = ViewBag.Q as string;
    var usuarioActualId = ViewBag.UsuarioActualId is int id ? id : 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Usuarios</h1>
        <p class="text-secondary mb-0">Cuentas de acceso, perfiles y control de bloqueo del sistema.</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Crear">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar usuario
        </a>
    </div>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-3">
            <label for="perfil" class="visually-hidden">Filtrar por perfil</label>
            <select id="perfil" name="perfil" class="form-select">
                <option value="">Todos los perfiles</option>
                <option value="@((int)Perfil.Administrador)" selected="@(perfil == Perfil.Administrador)">Administrador
                </option>
                <option value="@((int)Perfil.Veterinario)" selected="@(perfil == Perfil.Veterinario)">Veterinario
                </option>
                <option value="@((int)Perfil.Dueno)" selected="@(perfil == Perfil.Dueno)">Dueño</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label for="bloqueado" class="visually-hidden">Filtrar por estado</label>
            <select id="bloqueado" name="bloqueado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="false" selected="@(bloqueado == false)">Activos</option>
                <option value="true" selected="@(bloqueado == true)">Bloqueados</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label for="q" class="visually-hidden">Buscar usuario</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="text" id="q" name="q" value="@q" class="form-control"
                       placeholder="Cédula, nombre o correo..." />
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            @if (perfil.HasValue || bloqueado.HasValue || !string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        @if (perfil.HasValue || bloqueado.HasValue || !string.IsNullOrWhiteSpace(q))
        {
            <p class="mb-2">No se encontraron usuarios con los filtros seleccionados.</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos los usuarios</a>
            </div>
        }
        else
        {
            <p class="mb-3">No hay usuarios registrados. Agregue el primero.</p>
            <div>
                <a asp-action="Crear" class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar usuario
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Perfil</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var esUsuarioActual = item.Id == usuarioActualId;
                        <tr>
                            <td>@item.Cedula</td>
                            <td>
                                <span class="fw-bold">@item.Nombre</span>
                                @if (item.Perfil == Perfil.Veterinario && item.Veterinario is not null)
                                {
                                    <div class="small text-secondary">
                                        <i class="bi bi-person-badge" aria-hidden="true"></i> @item.Veterinario.NombreCompleto
                                        (@item.Veterinario.NumeroColegiado)
                                    </div>
                                }
                            </td>
                            <td>@item.Correo</td>
                            <td> @(item.Perfil == Perfil.Dueno ? "Dueño" : item.Perfil.ToString()) </td>
                            <td> @(item.Bloqueado ? "Bloqueado" : "Activo") </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-success" asp-action="Editar" asp-route-id="@item.Id"
                                   title="Editar" aria-label="Editar @item.Nombre">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>

                                @if (!esUsuarioActual)
                                {
                                    var confirmacion = item.Bloqueado ? $"¿Desbloquear al usuario {item.Nombre}"
                                    : $"¿Bloquear al usuario {item.Nombre}? No podra iniciar sesion hasta ser desbloqueado";

                                    <form asp-action="CambiarBloqueo" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('@confirmacion');">
                                        <button type="submit"
                                                class="btn btn-sm @(item.Bloqueado ? "btn-outline-dark" : "btn-outline-secondary")"
                                                title="@(item.Bloqueado ? "Desbloquear" : "Bloquear")"
                                                aria-label="@(item.Bloqueado ? "Desbloquear" : "Bloquear") @item.Nombre">
                                            <i class="bi @(item.Bloqueado ? "bi-unlock" : "bi-lock")" aria-hidden="true"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar este usuario?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                aria-label="Eliminar @item.Nombre">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}