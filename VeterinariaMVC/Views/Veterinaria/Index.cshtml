@model IEnumerable<VeterinariaMVC.Models.Mascota>
@{
    ViewData["Title"] = "Veterinaria";
    var q = ViewBag.Q as string;

    string TextoAtencion(DateTime? fecha)
    {
        if (fecha is null)
        {
            return "Sin atenciones";
        }

        var dias = (DateTime.Today - fecha.Value.Date).Days;
        return dias switch
        {
            <= 0 => "Hoy",
            1 => "Ayer",
            < 30 => $"Hace {dias} días",
            < 60 => "Hace 1 mes",
            < 365 => $"Hace {dias / 30} meses",
            _ => dias / 365 == 1 ? "Hace 1 año" : $"Hace {dias / 365} años"
        };
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Veterinaria</h1>
        <p class="text-secondary mb-0">Pacientes ordenados por su última atención, del más reciente al más antiguo.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="card p-3 mb-4" role="search">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-8 col-lg-6">
            <label for="q" class="visually-hidden">Nombre de la mascota o cédula del dueño</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" id="q" name="q" value="@q" class="form-control"
                       placeholder="Nombre de la mascota o cédula del dueño" />
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <p class="mb-2">No se encontraron mascotas que coincidan con «@q».</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todas las mascotas</a>
            </div>
        }
        else
        {
            <p class="mb-0">Todavía no hay mascotas registradas.</p>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 4rem;">Foto</th>
                        <th>Nombre</th>
                        <th>Especie y raza</th>
                        <th>Dueño</th>
                        <th>Última atención</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.FotoRuta))
                                {
                                    <img src="~/@item.FotoRuta" alt="Foto de @item.Nombre"
                                         class="rounded-circle object-fit-cover border" width="44" height="44" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary"
                                         style="width: 44px; height: 44px;" aria-hidden="true">
                                        <i class="bi bi-heart-fill"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>
                                <div>@item.Especie?.Nombre</div>
                                <div class="small text-secondary">@item.Raza?.Nombre</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.Dueno?.Nombre</div>
                                <div class="small text-secondary">Céd. @item.Dueno?.Cedula</div>
                            </td>
                            <td>
                                @if (item.UltimaAtencion is null)
                                {
                                    <span class="badge text-bg-light border">Sin atenciones</span>
                                }
                                else
                                {
                                    <div>@TextoAtencion(item.UltimaAtencion)</div>
                                    <div class="small text-secondary">@item.UltimaAtencion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-primary" asp-controller="Expediente" asp-action="Ver" asp-route-id="@item.Id"
                                   aria-label="Abrir expediente de @item.Nombre">
                                    <i class="bi bi-folder2-open" aria-hidden="true"></i> Abrir expediente
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
