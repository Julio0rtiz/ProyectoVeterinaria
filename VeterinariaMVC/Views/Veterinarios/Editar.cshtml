@model VeterinariaMVC.Models.ViewModels.VeterinarioFormViewModel
@{
    ViewData["Title"] = "Editar veterinario";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Editar veterinario</h1>
    <p class="text-secondary mb-0">Modifique los datos o reemplace la fotografía del veterinario.</p>
</div>

<div class="card p-4" style="max-width: 36rem;">
    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="NombreCompleto" class="form-label"></label>
            <input asp-for="NombreCompleto" class="form-control" maxlength="100" autofocus />
            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NumeroColegiado" class="form-label"></label>
            <input asp-for="NumeroColegiado" class="form-control" maxlength="20" />
            <span asp-validation-for="NumeroColegiado" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Fotografía actual</label>
            @if (!string.IsNullOrWhiteSpace(Model.FotoActual))
            {
                <img src="~/@Model.FotoActual" alt="Foto actual de @Model.NombreCompleto"
                     class="rounded-circle object-fit-cover border mb-2" width="72" height="72" />
            }
            else
            {
                <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary mb-2"
                     style="width: 72px; height: 72px;" aria-hidden="true">
                    <i class="bi bi-person-fill fs-2"></i>
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="Foto" class="form-label">Nueva fotografía (opcional)</label>
            <input asp-for="Foto" type="file" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
            <div class="form-text">Si selecciona una imagen nueva, reemplazará la actual (JPG o PNG, máx. 5 MB).</div>
            <span asp-validation-for="Foto" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar cambios
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}