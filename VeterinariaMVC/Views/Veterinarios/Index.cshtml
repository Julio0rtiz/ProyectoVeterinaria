@model IEnumerable<VeterinariaMVC.Models.Veterinario>
@{
    ViewData["Title"] = "Veterinarios";
    var q = ViewBag.Q as string;
    var vinculados = ViewBag.Vinculados as HashSet<int> ?? new HashSet<int>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Veterinarios</h1>
        <p class="text-secondary mb-0">Personal médico veterinario registrado en la clínica.</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Crear">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar veterinario
        </a>
    </div>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-8 col-lg-6">
            <label for="q" class="visually-hidden">Buscar veterinario</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="text" id="q" name="q" value="@q" class="form-control"
                       placeholder="Buscar por nombre o número de colegiado..." />
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <p class="mb-2">No se encontraron veterinarios que coincidan con «@q».</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos los veterinarios</a>
            </div>
        }
        else
        {
            <p class="mb-3">No hay veterinarios registrados. Agregue el primero.</p>
            <div>
                <a asp-action="Crear" class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar veterinario
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 4rem;">Foto</th>
                        <th>Nombre completo</th>
                        <th>Número de colegiado</th>
                        <th>Cuenta de usuario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.FotoRuta))
                                {
                                    <img src="~/@item.FotoRuta" alt="Foto de @item.NombreCompleto"
                                         class="rounded-circle object-fit-cover border" width="44" height="44" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary"
                                         style="width: 44px; height: 44px;" aria-hidden="true">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@item.NombreCompleto</td>
                            <td>
                                <span class="badge text-bg-light border">@item.NumeroColegiado</span>
                            </td>
                            <td>
                                @if (vinculados.Contains(item.Id))
                                {
                                    <span class="badge text-bg-success">Vinculado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Sin usuario</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"
                                   title="Editar" aria-label="Editar @item.NombreCompleto">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar este veterinario?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                            aria-label="Eliminar @item.NombreCompleto">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}